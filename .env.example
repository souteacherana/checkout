# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (gateway de pagamento)
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Astron Members — URL secreta do webhook de matrícula automática.
# Quem possui essa URL consegue matricular alunos; NUNCA commitar o valor real.
ASTRON_WEBHOOK_URL=

# Eduzz (sync de vendas históricas)
EDUZZ_CLIENT_ID=
EDUZZ_CLIENT_SECRET=

# Facebook Pixel (fallback global; por produto fica na tabela products)
NEXT_PUBLIC_FB_PIXEL_ID=

# Meta CAPI da landing (/api/capi) — espelha no servidor os eventos que a
# landing dispara no navegador, com o mesmo eventId, pra Meta deduplicar.
# Sem o token a rota responde 200 sem enviar nada: o Pixel do browser continua
# funcionando e a landing não quebra.
META_CAPI_ACCESS_TOKEN=

# Google tag (gtag.js) — GA4 + Google Ads, convivendo com o Meta Pixel.
# Não roda no /admin (ver src/app/google-tag.tsx).
# NEXT_PUBLIC_GOOGLE_TAG_ID: o tag da conta, na forma G- (ex: G-WVX3E9E4ME).
# GOOGLE_ADS_ID/_LABEL: conversão de Compra padrão; por produto fica na
# tabela products (google_ads_conversion_id / _label).
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=

# Mailchimp — e-mail automático com a sala do Zoom após pagamento confirmado.
# A API key traz o server prefix no sufixo (ex: ...-us14).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
